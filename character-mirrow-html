}

/* SCENARIO */

.scenario-number{

color:#72f1d5;

font-size:.75rem;

font-weight:bold;

letter-spacing:2px;

margin-bottom:12px;

}

.scenario-title{

font-size:
clamp(1.5rem,4vw,2.3rem);

margin-bottom:12px;

}

.scenario-text{

color:#aeb7c5;

line-height:1.7;

max-width:700px;

margin:auto;

}

/* CHOICES */

.choices{

display:grid;

grid-template-columns:
repeat(2,1fr);

gap:15px;

max-width:750px;

margin:30px auto 0;

}

.choice{

padding:20px;

border-radius:18px;

border:
1px solid
rgba(120,170,255,.18);

background:
rgba(255,255,255,.045);

