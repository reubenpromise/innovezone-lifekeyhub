<script>

/* ==========================================
   LIFEKEY CHARACTER MIRROR V1.0
   BEHAVIOURAL ENGINE
========================================== */


/*
Each scenario contains several behavioural
signals.

The system does NOT say:

"You are a liar."

Instead it accumulates patterns such as:

honesty
anger
responsibility
empathy
self_control
communication
*/


const scenarios = [

{

title:"A Promise",

text:
"You promised a friend that you would help them with an important task. On the day, you realise you don't really want to go.",

choices:[

{
label:"A",
text:"Tell them honestly that you changed your mind.",
scores:{
honesty:3,
responsibility:1,
communication:2
}
},

{
label:"B",
text:"Make up an excuse so you don't look bad.",
scores:{
honesty:-3,
responsibility:-1,
communication:-1
}
},

{
label:"C",
text:"Ignore their messages and hope they stop asking.",
scores:{
honesty:-2,
responsibility:-3,
selfControl:-1
}
},

{
label:"D",
text:"Go because you gave your word, even though you don't feel like it.",
scores:{
responsibility:3,
selfControl:2,
honesty:2
}
}

]

},

{

title:"Someone Insults You",

text:
"Someone says something disrespectful about you in front of other people.",

choices:[

{
label:"A",
text:"Immediately insult them back.",
scores:{
anger:3,
selfControl:-2,
communication:-2
}
},

{
label:"B",
text:"Take a moment before responding.",
scores:{
selfControl:3,
anger:-2,
communication:2
}
},

{
label:"C",
text:"Calmly tell them that you don't appreciate what they said.",
scores:{
communication:3,
selfControl:2,
anger:-1
}
},

{
label:"D",
text:"Pretend you're fine but plan how to get revenge later.",
scores:{
anger:2,
malice:3,
selfControl:-1
}
}

]

},

{

title:"A Mistake",

text:
"You accidentally damage something belonging to another person. Nobody saw what happened.",

choices:[

{
label:"A",
text:"Tell the owner what happened and accept responsibility.",
scores:{
honesty:3,
responsibility:3
}
},

{
label:"B",
text:"Keep quiet because nobody knows.",
scores:{
honesty:-3,
responsibility:-3
}
},

{
label:"C",
text:"Blame someone else if they ask.",
scores:{
honesty:-4,
responsibility:-3,
malice:1
}
},

{
label:"D",
text:"Try to repair or replace it before telling them.",
scores:{
responsibility:2,
honesty:1
}
}

]

},

{

title:"Someone Succeeds",

text:
"A person you know achieves something you badly wanted for yourself.",

choices:[

{
label:"A",
text:"Congratulate them sincerely.",
scores:{
empathy:3,
selfControl:2
}
},

{
label:"B",
text:"Pretend to congratulate them while secretly wishing they fail.",
scores:{
malice:2,
empathy:-2
}
},

{
label:"C",
text:"Avoid them because you feel jealous.",
scores:{
selfControl:-1,
empathy:-1
}
},

{
label:"D",
text:"Ask them how they achieved it so you can learn.",
scores:{
empathy:2,
selfControl:3,
responsibility:2
}
}

]

},

{

title:"An Angry Moment",

text:
"You are already frustrated when someone makes a small mistake that causes you more inconvenience.",

choices:[

{
label:"A",
text:"Shout at them immediately.",
scores:{
anger:4,
selfControl:-3,
communication:-2
}
},

{
label:"B",
text:"Take a breath and explain the problem.",
scores:{
anger:-2,
selfControl:3,
communication:3
}
},

{
label:"C",
text:"Say nothing, but remain visibly hostile.",
scores:{
anger:2,
communication:-1,
selfControl:1
}
},

{
label:"D",
text:"Ask what happened before deciding how to respond.",
scores:{
anger:-2,
selfControl:3,
communication:2,
empathy:2
}
}

]

},

{

title:"The Difficult Truth",

text:
"You discover that telling the complete truth may embarrass you.",

choices:[

{
label:"A",
text:"Tell the truth even though it makes you uncomfortable.",
scores:{
honesty:4,
selfControl:2
}
},

{
label:"B",
text:"Change part of the story to protect yourself.",
scores:{
honesty:-2,
selfControl:-1
}
},

{
label:"C",
text:"Tell a completely different story.",
scores:{
honesty:-4
}
},

{
label:"D",
text:"Say that you would rather discuss it privately.",
scores:{
honesty:2,
communication:3,
selfControl:2
}
}

]

}

];


/* BEHAVIOURAL PROFILE */

let profile = {

honesty:0,

anger:0,

responsibility:0,

empathy:0,

selfControl:0,

communication:0,

malice:0

};

let currentScenario = 0;


/* START */

function startGame(){

showScreen("characterIntro");

}


/* BEGIN SCENARIOS */

function beginScenarios(){

currentScenario = 0;

resetProfile();

showScreen("scenarioScreen");

loadScenario();

}


/* RESET */

function resetProfile(){

profile = {

honesty:0,

anger:0,

responsibility:0,

empathy:0,

selfControl:0,

communication:0,

malice:0

};

}


/* LOAD SCENARIO */

function loadScenario(){

const scenario =
scenarios[currentScenario];

document.getElementById("scenarioNumber")
.innerText =
"SCENARIO " +
(currentScenario + 1) +
" OF " +
scenarios.length;

document.getElementById("scenarioTitle")
.innerText =
scenario.title;

document.getElementById("scenarioText")
.innerText =
scenario.text;


const choices =
document.getElementById("choices");

choices.innerHTML = "";


scenario.choices.forEach(choice => {

const button =
document.createElement("button");

button.className = "choice";

button.innerHTML =

"<strong>" +
choice.label +
"</strong>" +

choice.text;

button.onclick = () => {

selectChoice(choice);

};

choices.appendChild(button);

});


const progress =
((currentScenario) /
scenarios.length) * 100;

document.getElementById("progressBar")
.style.width =
progress + "%";

}


/* CHOICE */

function selectChoice(choice){

for(const key in choice.scores){

if(profile[key] !== undefined){

profile[key] +=
choice.scores[key];

}

}


currentScenario++;


if(currentScenario >= scenarios.length){

showResults();

}else{

loadScenario();

}

}


/* RESULTS */

function showResults(){

document.getElementById("progressBar")
.style.width = "100%";

showScreen("resultScreen");

const patterns =
document.getElementById("patterns");

patterns.innerHTML = "";


/*
Convert scores into understandable
display values.

This is an early prototype.
We will make the scoring system
more sophisticated later.
*/

const maxValues = {

honesty:12,

anger:12,

responsibility:10,

empathy:8,

selfControl:12,

communication:10,

malice:6

};


const names = {

honesty:"Honesty",

anger:"Anger Response",

responsibility:"Responsibility",

empathy:"Empathy",

selfControl:"Self-Control",

communication:"Communication",

malice:"Hostility / Malice"

};


const sorted =
Object.keys(profile)
.sort((a,b) =>
Math.abs(profile[b]) -
Math.abs(profile[a])
);


sorted.forEach(key => {

let raw =
profile[key];

let percentage =
50 +
(raw /
maxValues[key]) *
50;

percentage =
Math.max(
5,
Math.min(95,percentage)
);

const div =
document.createElement("div");

div.className = "pattern";

div.innerHTML = `

<div class="pattern-top">

<span class="pattern-name">
${names[key]}
</span>

<span class="pattern-score">
${Math.round(percentage)}%
</span>

</div>

<div class="bar">

<div
class="bar-fill"
style="width:${Math.round(percentage)}%">
</div>

</div>

`;

patterns.appendChild(div);

});


createTraining(sorted);

}


/* TRAINING */

function createTraining(sorted){

const training =
document.getElementById("training");

const strongest =
sorted[0];


let title = "";
let text = "";


if(strongest === "anger"){

title =
"🔥 Your Development Focus: Emotional Control";

text =
"Practice creating a short pause between feeling angry and responding. Before answering during a difficult moment, take one breath and deliberately choose your words.";

}

else if(strongest === "honesty"){

title =
"🟢 Your Development Focus: Integrity";

text =
"Continue strengthening honesty by choosing truth even when honesty is uncomfortable or inconvenient.";

}

else if(strongest === "responsibility"){

title =
"⚙️ Your Development Focus: Responsibility";

text =
"Continue practising ownership of your decisions. A strong character does not always avoid mistakes—it learns to acknowledge and correct them.";

}

else if(strongest === "empathy"){

title =
"❤️ Your Development Focus: Understanding Others";

text =
"Continue practising the habit of considering what another person may be experiencing before judging their behaviour.";

}

else if(strongest === "selfControl"){

title =
"🧠 Your Development Focus: Self-Control";

text =
"Self-control grows through repeated small decisions. Practise pausing before reacting whenever you feel pressure, anger or temptation.";

}

else if(strongest === "communication"){

title =
"🗣️ Your Development Focus: Communication";

text =
"Practise expressing disagreement without attacking the person. Focus on explaining the problem rather than trying to win the argument.";

}

else if(strongest === "malice"){

title =
"🧭 Your Development Focus: Intentional Responses";

text =
"Notice moments when anger or jealousy makes you want to hurt, embarrass or undermine another person. Practise stepping back before acting on that impulse.";

}

else{

title =
