height:90px;

border-radius:20px;

background:
linear-gradient(
145deg,
#ffd8b5,
#d99b72
);

}

.arm.left{
left:7px;
transform:rotate(8deg);
}

.arm.right{
right:7px;
transform:rotate(-8deg);
}

.leg{

