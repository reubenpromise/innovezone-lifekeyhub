background:#17213b;

}

.leg.left{
left:35px;
}

.leg.right{
right:35px;
}

/* SPEECH */

.speech{

max-width:700px;

margin:0 auto 25px;

padding:22px;

border-radius:20px;

background:
rgba(255,255,255,.055);

border:
1px solid
rgba(114,241,213,.17);

text-align:left;

position:relative;

}

.speech:after{

content:"";

position:absolute;

bottom:-10px;
left:50%;

width:20px;
height:20px;

background:
rgba(255,255,255,.055);

border-right:
1px solid
rgba(114,241,213,.17);

border-bottom:
1px solid
rgba(114,241,213,.17);

transform:
translateX(-50%)
rotate(45deg);

}

.speaker{

color:#72f1d5;

font-size:.75rem;

font-weight:bold;

